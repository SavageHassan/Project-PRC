# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://projectprc.org

# WordPress install that keeps running GiveWP (donations) once this front end takes over the main domain.
# Example after DNS cutover: https://wp.projectprc.org
NEXT_PUBLIC_WP_URL=https://projectprc.org

# Where images are served from. Default hot-links the existing WordPress uploads.
# Run `npm run fetch-assets` to download them into /public/media, then set this to /media
NEXT_PUBLIC_MEDIA_BASE=https://projectprc.org/wp-content/uploads

# Native forms (volunteer, corporate inquiry, Network inquiry, scholarship notify) POST here as JSON.
# Point at a HubSpot workflow webhook, Zapier/Make hook, or any endpoint that emails the team.
FORMS_WEBHOOK_URL=
